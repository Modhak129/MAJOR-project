# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed for your local environment.
# ==============================================================================

# Flask Dashboard Configuration
FLASK_ENV=development
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000

# Edge Client / Inference Node Configuration
CLIENT_ID=node_constrained
SIMULATED_VRAM_MB=2048
CPU_CORES=2
SERVER_ADDRESS=127.0.0.1:8080
DASHBOARD_URL=http://127.0.0.1:5000

# Model Execution Constraints
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
YOLO_VERBOSE=False
